generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  books         Book[]
  sessions      Session[]
  googleAccount GoogleAccount?
}

model GoogleAccount {
  id                    String    @id @default(cuid())
  googleId              String    @unique
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id               String   @id @default(cuid())
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id               String               @id @default(cuid())
  title            String
  author           String?
  fileUrl          String
  fileType         String
  coverUrl         String?
  coverData        Bytes?
  coverMimeType    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress         ReadingProgress?
  highlights       Highlight[]
  annotations      Annotation[]
  sections         BookSection[]
  sourceFileId     String?
  processingStatus BookProcessingStatus @default(PENDING)
  processingError  String?
  wordCount        Int                  @default(0)
  contentReviewedByAi Boolean           @default(false)
  removedSectionCount Int               @default(0)

  @@unique([userId, sourceFileId])
  @@index([userId, createdAt])
}

model BookSection {
  id                String   @id @default(cuid())
  position          Int
  title             String?
  content           String   @db.Text
  wordCount         Int      @default(0)
  extractionMethod  String   @default("unknown")
  extractionQuality Float?
  createdAt         DateTime @default(now())
  bookId            String
  book              Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, position])
  @@index([bookId])
}

enum BookProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model ReadingProgress {
  id         String   @id @default(cuid())
  location   String
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
  bookId     String   @unique
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Highlight {
  id        String   @id @default(cuid())
  cfiRange  String
  text      String
  color     String   @default("yellow")
  createdAt DateTime @default(now())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model Annotation {
  id        String   @id @default(cuid())
  content   String
  cfiRange  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}
